{
  "name": "elegant-ui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare-demo": "node scripts/prepare-compose-demo.mjs",
    "docs:dev": "npm run docs:prepare-demo && vitepress dev .",
    "docs:check": "node scripts/validate-docs.mjs",
    "docs:build": "npm run docs:check && npm run docs:prepare-demo && vitepress build .",
    "docs:preview": "vitepress preview ."
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.18"
  }
}
